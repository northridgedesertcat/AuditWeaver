{
  "name": "log-structured-sink",
  "config": {
    "connector.class": "io.confluent.connect.elasticsearch.ElasticsearchSinkConnector",

    "topics": "log.structured",

    "tasks.max": "1",

    "connection.url": "http://elasticsearch:9200",

    "external.resource.usage": "INDEX",

    "topic.to.external.resource.mapping": "log.structured:nginx-log-raw",

    "key.ignore": "true",

    "schema.ignore": "true",

    "behavior.on.null.values": "ignore",

    "write.method": "INSERT"
  }
}