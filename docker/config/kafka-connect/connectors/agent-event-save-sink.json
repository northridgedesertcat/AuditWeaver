{
  "name": "agent-event-save-sink",
  "config": {
    "connector.class": "io.confluent.connect.elasticsearch.ElasticsearchSinkConnector",

    "topics": "agent.event.save",

    "tasks.max": "1",

    "connection.url": "http://elasticsearch:9200",

    "external.resource.usage": "INDEX",

    "topic.to.external.resource.mapping": "agent.event.save:log_analysis_reports",

    "key.ignore": "false",

    "schema.ignore": "true",

    "behavior.on.null.values": "ignore",

    "write.method": "UPSERT"
  }
}
