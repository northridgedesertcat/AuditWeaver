# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost
DJANGO_PORT=8000
DJANGO_CORS_ALLOW_ALL_ORIGINS=True
DJANGO_TIME_ZONE=UTC

# Elasticsearch
ES_HOST=localhost
ES_PORT=19200
ES_USER=elastic
ES_PASSWORD=password
ES_SCHEME=http
ES_USE_SSL=False
ES_VERIFY_CERTS=False

# Kafka
KAFKA_BROKERS=localhost:29092
KAFKA_CONNECT_HOST=localhost
KAFKA_CONNECT_PORT=8083

# Kafka Topics
KAFKA_TOPIC_RAW=log.raw
KAFKA_TOPIC_STRUCTURED=log.structured
KAFKA_TOPIC_ANALYSIS=log.analysis
KAFKA_TOPIC_RISK=log.risk

# ES Indexes（AI 分析报告已迁移至 MySQL，无报告索引）
ES_INDEX_MATCHED_LOGS=matched_logs
ES_INDEX_NGINX_RAW=nginx-log-raw

# Dify
DIFY_BASE_URL=http://localhost/v1
DIFY_API_KEY=
DIFY_TIMEOUT=60

# Frontend
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Logging
LOG_LEVEL=INFO

# Docker Ports
ZOOKEEPER_PORT=2181
KIBANA_PORT=5601

# ============================================================
# Agent Service(对内 FastAPI,只服务 Django)
# ============================================================
# FastAPI 监听地址/端口(不对外,仅 127.0.0.1)
AE_BACKEND_HOST=127.0.0.1
AE_BACKEND_PORT=8001

# Django 反代目标(Django → FastAPI)
AGENT_FASTAPI_BASE=http://127.0.0.1:8001

# LLM(OpenAI 兼容,按配置切换厂商;所有 agent 共用)
# 切换 DeepSeek / Qwen / GLM / Kimi / OpenAI / Ollama,只改下面三项,不改代码
# model 必须显式指定(不硬编码默认值),base_url 默认指向本地 Ollama
AE_LLM_PROVIDER=openai_compat
AE_LLM_BASE_URL=http://localhost:11434/v1
AE_LLM_API_KEY=ollama
AE_LLM_MODEL=
AE_LLM_TEMPERATURE=0.2

# Light LLM(可选,用于 validate / decision gate / compact 等弱推理任务,省钱)
# 不配置则默认复用 analysis 角色的 model/base_url/api_key
AE_LLM_LIGHT_PROVIDER=openai_compat
AE_LLM_LIGHT_BASE_URL=http://localhost:11434/v1
AE_LLM_LIGHT_API_KEY=ollama
AE_LLM_LIGHT_MODEL=
AE_LLM_LIGHT_TEMPERATURE=0.1

# Report LLM(可选,用于 workflow report 节点生成最终报告)
# 不配置则默认复用 analysis 角色的 model/base_url/api_key
AE_LLM_REPORT_PROVIDER=openai_compat
AE_LLM_REPORT_BASE_URL=http://localhost:11434/v1
AE_LLM_REPORT_API_KEY=ollama
AE_LLM_REPORT_MODEL=
AE_LLM_REPORT_TEMPERATURE=0.2

# RAG Embedding(可选,用于向量检索)
# chat 厂商(如 DeepSeek 官方)不一定提供 /embeddings,需配置独立 endpoint
# 三项都留空 → RAG 降级为空 EvidencePack,不影响主 Workflow
# 本地 Ollama 示例:拉取 nomic-embed-text 后填下方
AE_RAG_EMBEDDING_BASE_URL=
AE_RAG_EMBEDDING_API_KEY=
AE_RAG_EMBEDDING_MODEL=
# 向量维度(text-embedding-3-small=1536, bge-m3=1024, nomic-embed-text=768)
AE_RAG_EMBEDDING_DIM=768

# Skills(连 ES,沿用 common.env 的 ES_HOST 等,无需重复;报告走 MySQL)
AE_SKILL_ES_INDEX_RAW=nginx-log-raw
AE_SKILL_ES_INDEX_EVENTS=matched_logs

# Agent 行为(全局默认,可在 agents/<name>/config 中覆盖)
AE_AGENT_MAX_TOOL_ROUNDS=5
AE_AGENT_TOOL_TIMEOUT=30

# 会话历史(memory=进程内,不依赖 Redis;redis=使用 RedisSaver 持久化)
AE_MEMORY_BACKEND=memory
AE_MEMORY_REDIS_URL=redis://:change-me@localhost:16379/0

# ============================================================
# MySQL(走 Docker 单容器,对外端口 13306)
# ============================================================
MYSQL_HOST=localhost
MYSQL_PORT=13306
MYSQL_DATABASE=auditweaver
MYSQL_USER=auditweaver
MYSQL_PASSWORD=auditweaver
MYSQL_ROOT_PASSWORD=rootpass

# ============================================================
# Redis(走 Docker 单容器,对外端口 16379)
# ⚠️ 实际 .env 必须改为你自己的强密码,不要使用 change-me
# Django / Agent 均在宿主机本地启动 → 用 localhost:16379
#   REDIS_URL            :Django Cache 连接地址
#   AE_MEMORY_REDIS_URL  :Agent Service RedisSaver 连接地址
# (容器内服务名 redis:6379 仅当应用也容器化时才用,当前不适用)
# ============================================================
REDIS_URL=redis://:change-me@localhost:16379/0
REDIS_PASSWORD=change-me
REDIS_PORT=16379

# ============================================================
# JWT(djangorestframework-simplejwt)
# ============================================================
JWT_SECRET_KEY=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=1

# ============================================================
# Root Admin 不在 .env 配置;首次部署执行(交互式,密码哈希入库):
#   python manage.py create_root_admin
# 普通 Admin 由 Root Admin 登录后创建
# ============================================================
