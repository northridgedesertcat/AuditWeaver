# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost
DJANGO_PORT=8000
DJANGO_CORS_ALLOW_ALL_ORIGINS=True
DJANGO_TIME_ZONE=UTC

# Elasticsearch
ES_HOST=localhost
ES_PORT=19200
ES_USER=elastic
ES_PASSWORD=password
ES_SCHEME=http
ES_USE_SSL=False
ES_VERIFY_CERTS=False

# Kafka
KAFKA_BROKERS=localhost:29092
KAFKA_CONNECT_HOST=localhost
KAFKA_CONNECT_PORT=8083

# Kafka Topics
KAFKA_TOPIC_RAW=log.raw
KAFKA_TOPIC_STRUCTURED=log.structured
KAFKA_TOPIC_ANALYSIS=log.analysis
KAFKA_TOPIC_RISK=log.risk

# ES Indexes（AI 分析报告已迁移至 MySQL，无报告索引）
ES_INDEX_MATCHED_LOGS=matched_logs
ES_INDEX_NGINX_RAW=nginx-log-raw

# Dify
DIFY_BASE_URL=http://localhost/v1
DIFY_API_KEY=
DIFY_TIMEOUT=60

# Frontend
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Logging
LOG_LEVEL=INFO

# Docker Ports
ZOOKEEPER_PORT=2181
KIBANA_PORT=5601

# ============================================================
# Agent Service(对内 FastAPI,只服务 Django)
# ============================================================
# FastAPI 监听地址/端口(不对外,仅 127.0.0.1)
AE_BACKEND_HOST=127.0.0.1
AE_BACKEND_PORT=8001

# Django 反代目标(Django → FastAPI)
AGENT_FASTAPI_BASE=http://127.0.0.1:8001

# LLM(OpenAI 兼容,按配置切换厂商;所有 agent 共用)
# 切换 DeepSeek / Qwen / GLM / Kimi / OpenAI 官方,只改下面三项,不改代码
AE_LLM_PROVIDER=openai_compat
AE_LLM_BASE_URL=https://api.deepseek.com/v1
AE_LLM_API_KEY=sk-xxx
AE_LLM_MODEL=deepseek-chat
AE_LLM_TEMPERATURE=0.2

# Skills(连 ES,沿用 common.env 的 ES_HOST 等,无需重复;报告走 MySQL)
AE_SKILL_ES_INDEX_RAW=nginx-log-raw
AE_SKILL_ES_INDEX_EVENTS=matched_logs

# Agent 行为(全局默认,可在 agents/<name>/config 中覆盖)
AE_AGENT_MAX_TOOL_ROUNDS=5
AE_AGENT_TOOL_TIMEOUT=30

# 会话历史(一版进程内,预留 Redis)
AE_MEMORY_BACKEND=memory
# AE_MEMORY_REDIS_URL=redis://localhost:6379/0

# ============================================================
# MySQL(走 Docker 单容器,对外端口 13306)
# ============================================================
MYSQL_HOST=localhost
MYSQL_PORT=13306
MYSQL_DATABASE=auditweaver
MYSQL_USER=auditweaver
MYSQL_PASSWORD=auditweaver
MYSQL_ROOT_PASSWORD=rootpass

# ============================================================
# JWT(djangorestframework-simplejwt)
# ============================================================
JWT_SECRET_KEY=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=1

# ============================================================
# 初始管理员(首次启动创建;改密需登录后台或自管)
# ============================================================
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=admin123456
INITIAL_ADMIN_EMAIL=admin@auditweaver.local
