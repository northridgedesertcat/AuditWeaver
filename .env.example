# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost
DJANGO_PORT=8000
DJANGO_CORS_ALLOW_ALL_ORIGINS=True
DJANGO_TIME_ZONE=UTC

# Elasticsearch
ES_HOST=localhost
ES_PORT=19200
ES_USER=elastic
ES_PASSWORD=password
ES_SCHEME=http
ES_USE_SSL=False
ES_VERIFY_CERTS=False

# Kafka
KAFKA_BROKERS=localhost:29092
KAFKA_CONNECT_HOST=localhost
KAFKA_CONNECT_PORT=8083

# Kafka Topics
KAFKA_TOPIC_RAW=log.raw
KAFKA_TOPIC_STRUCTURED=log.structured
KAFKA_TOPIC_ANALYSIS=log.analysis
KAFKA_TOPIC_RISK=log.risk

# ES Indexes
ES_INDEX_MATCHED_LOGS=matched_logs
ES_INDEX_ANALYSIS_REPORTS=log_analysis_reports
ES_INDEX_NGINX_RAW=nginx-log-raw

# Dify
DIFY_BASE_URL=http://localhost/v1
DIFY_API_KEY=
DIFY_TIMEOUT=60

# Frontend
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Logging
LOG_LEVEL=INFO

# Docker Ports
ZOOKEEPER_PORT=2181
KIBANA_PORT=5601
